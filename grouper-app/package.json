{
  "name": "grouper-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4204",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:a11y": "ng test --watch=false --include src/app/**/*.a11y.spec.ts",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "dkfds": "^11.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.11.3",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^4.0.0",
    "jsdom": "^28.1.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.0.8"
  }
}
